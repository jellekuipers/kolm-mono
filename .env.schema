# The workspace's environment: every variable, its type, default and which package
# reads it (`@tag`). Packages import their slice with `@import(../../, pick=[#tag])`.
# Put local values and secrets in `.env.local` (gitignored), and per-environment
# values in `.env.[APP_ENV]` (e.g. `.env.production`). Real environment variables
# always win. Validate with `vpx varlock load`.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @currentEnv=$APP_ENV
# ---

# Selects which `.env.[APP_ENV]` files are loaded.
# @tag(server, client, db) @type=enum(development, test, production)
APP_ENV=development

# --- client (apps/client) ---

# Where the client's server (SSR, loaders, the /api proxy) reaches the API.
# Read at runtime (`@dynamic`), so a build works against any API.
# @tag(client) @type=url(noTrailingSlash=true) @dynamic
API_URL=http://127.0.0.1:3000

# Read the user's IP from `X-Forwarded-For`, set by a reverse proxy in front of the client.
# Only enable behind a proxy that overwrites that header, or users can spoof their IP.
# Read at runtime (`@dynamic`), like API_URL.
# @tag(client) @type=boolean @dynamic
TRUST_PROXY=false

# --- server (apps/server) ---

# Port the API listens on. Not `PORT`: hosts and tools set that for whichever process
# they run, and the client and server share a shell in dev. On a host that assigns
# a port, set API_PORT=$PORT for the server.
# @tag(server) @type=port
API_PORT=3000

# Interface the API listens on. Loopback by default: the API trusts x-forwarded-*
# headers (set by the client's /api proxy), so it must not be reachable directly.
# Set 0.0.0.0 only behind a proxy that overwrites those headers, e.g. in a container.
# @tag(server)
API_HOST=127.0.0.1

# @tag(server) @type=enum(debug, info, warn, error, silent)
LOG_LEVEL=info

# One JSON object per line, or human-readable.
# @tag(server) @type=enum(pretty, json)
LOG_FORMAT=if(eq($APP_ENV, production), json, pretty)

# Requests per minute per client IP to /api and /mcp (liveness excluded).
# better-auth rate-limits /api/auth on its own as well.
# @tag(server) @type=number(min=1, isInt=true)
API_RATE_LIMIT=300

# Comma-separated origins allowed to call /mcp from a browser. Clients that send
# no Origin (Claude Code, the MCP Inspector CLI) are always allowed.
# @tag(server) @example="http://localhost:6274"
MCP_ALLOWED_ORIGINS=

# --- database (packages/db) ---

# Postgres URL. Unset: no database, and /api/health/ready reports it as "disabled".
# `vp run db:up` starts a local Postgres that matches the example.
# @tag(server, db) @sensitive @type=url(allowedProtocols=[postgres, postgresql])
# @example="postgresql://postgres:postgres@localhost:5432/app"
DATABASE_URL=

# Host port of the local Postgres (`vp run db:up`). Change it if 5432 is taken,
# and match it in DATABASE_URL.
# @tag(db) @type=port
POSTGRES_PORT=5432

# --- auth (packages/auth) ---

# Enables better-auth, together with DATABASE_URL and a GitHub OAuth app. Generate one with
# `openssl rand -base64 32 | vpx varlock encrypt` and paste the result in .env.local.
# @tag(server) @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The origin users reach the app on (the client). Auth cookies and redirects use it.
# @tag(server) @type=url(noTrailingSlash=true)
BETTER_AUTH_URL=http://localhost:3001

# "Sign in with GitHub": create an OAuth app at https://github.com/settings/developers
# with homepage BETTER_AUTH_URL and callback URL <BETTER_AUTH_URL>/api/auth/callback/github.
# Use a separate app per environment.
# @tag(server)
GITHUB_CLIENT_ID=

# @tag(server) @sensitive
GITHUB_CLIENT_SECRET=
