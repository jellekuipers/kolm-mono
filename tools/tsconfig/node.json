{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "kolm-mono node (packages and server, run by Node's type stripping)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "erasableSyntaxOnly": true
  }
}
