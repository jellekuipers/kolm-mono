{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "kolm-mono react (bundled browser + SSR app)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "noUncheckedSideEffectImports": true
  }
}
